# ============================================================
# PARKSAFE QR - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
#
# IN DEVELOPMENT:
# Leave blank or use local URLs. Default fallback is:
# REACT_APP_API_BASE_URL=http://127.0.0.1:8000/api
# REACT_APP_FRONTEND_URL=http://localhost:3000
#
# IN PRODUCTION:
# Set the public HTTPS domains where your frontend and backend are hosted.
# Example:
# REACT_APP_FRONTEND_URL=https://app.parksafeqr.com
# REACT_APP_API_BASE_URL=https://api.parksafeqr.com/api
#
# FOR STAGING / TEMPORARY EXTERNAL TESTING (e.g. ngrok / Cloudflare Tunnel):
# REACT_APP_FRONTEND_URL=https://<your-frontend-tunnel>.ngrok-free.app
# REACT_APP_API_BASE_URL=https://<your-backend-tunnel>.ngrok-free.app/api
# ============================================================

REACT_APP_API_BASE_URL=http://127.0.0.1:8000/api
REACT_APP_FRONTEND_URL=http://localhost:3000
