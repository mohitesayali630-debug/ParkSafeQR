# ============================================================
# PARKSAFE QR - DJANGO BACKEND ENVIRONMENT CONFIGURATION
# ============================================================
#
# IN LOCAL DEVELOPMENT:
# The settings automatically fall back to local PostgreSQL and localhost settings.
#
# IN PRODUCTION:
# Set the following variables on your hosting server (Render, Railway, AWS, DigitalOcean, etc.):
#
# DJANGO_SECRET_KEY=your-strong-production-secret-key
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=api.yourdomain.com,yourdomain.com
#
# DATABASE CONFIGURATION (PostgreSQL):
# For cloud platforms (Render, Supabase, Neon):
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# Or configure individual variables:
# DB_NAME=parksafe_db
# DB_USER=postgres
# DB_PASSWORD=your_db_password
# DB_HOST=your_db_host
# DB_PORT=5432
#
# CORS CONFIGURATION (Allowed Frontend Domains):
# CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://yourdomain.com
#
# EMAIL (GMAIL SMTP or SendGrid/SES):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_app_password
# DEFAULT_FROM_EMAIL=your_email@gmail.com
# ============================================================

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DB_NAME=parksafe_db
DB_USER=postgres
DB_PASSWORD=123456
DB_HOST=127.0.0.1
DB_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
